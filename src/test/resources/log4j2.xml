<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_DIR">logs</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5p %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- Console output -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <!-- Rolling file: captures everything -->
        <RollingFile name="AllFile"
                     fileName="${LOG_DIR}/test-all.log"
                     filePattern="${LOG_DIR}/archive/test-all-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <!-- roll daily and also when file > 10 MB -->
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Optional: tame very noisy 3rd-party libs but still show them -->
        <Logger name="org.springframework" level="info" additivity="true"/>
        <Logger name="org.apache.http" level="info" additivity="true"/>
        <Logger name="org.openqa.selenium" level="info" additivity="true"/>
        <Logger name="io.netty" level="warn" additivity="true"/>

        <!-- Root logger: logs EVERYTHING to both console and file -->
        <Root level="debug">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AllFile"/>
        </Root>
    </Loggers>
</Configuration>
